# Copy to .env and fill in. .env is gitignored.

# Telegram group chat the bridge talks to (get it from @userinfobot).
TELEGRAM_CHAT_ID=-1001234567890

# Bot token from @BotFather. IMPORTANT: if another bridge (e.g. the Java tgbridge
# plugin) already polls this token, Telegram returns 409 Conflict — use a second
# bot for this server. See README "The 409 rule".
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME

# Leave api.telegram.org unless you run your own Bot API server.
TELEGRAM_API_BASE=https://api.telegram.org

# Public IP for NetherNet's UDP range; empty = auto-detect (Linux only).
MC_PUBLIC_IP=

MC_SERVER_NAME=minecraft-bedrock
MC_LEVEL_NAME=world